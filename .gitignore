# ===========================================================================
# Zero-Hallucination Academic Agent Workflow — ignore rules
# ===========================================================================

# --- Archived / non-academic scratch (kept locally, never committed) -------
_attic/
.workbuddy/
4k-image-api/
pelican_bicycle.svg
pelican_viewer.html
PI-DARWIN-SELECTION.md
gate_summary.json

# --- Vendored dependencies (regenerate with: pip install -r requirements.txt)
newwork/libs/

# --- Example literature pools -------------------------------------------------
# Large third-party PDFs (copyright) and their extracted text are inputs, not
# source. Keep them on disk for local runs; fetch with scripts/litpool_fetch.py.
newwork/examples/*/input/
newwork/examples/*/work/pdftext/
newwork/examples/*/deliverables/*.xlsx

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# --- LaTeX auxiliary compilation files ---------------------------------------
*.aux
*.toc
*.lof
*.lot
*.out
*.nav
*.snm
*.vrb
*.bcf
*.run.xml
*.synctex.gz
*.fls
*.fdb_latexmk

# Ignore root/intermediate LaTeX logs, but preserve authentic execution logs
*.log
!*/logs/*.log
!logs/*.log

# --- OS & Editor -------------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- Demo / scratch outputs (regenerated by zhaw) ------------------------------
_demo/
_attic/

_ci_*/

# 门禁运行产物（含子目录；不要提交别人的真实姓名与路径）
gate_summary.json
audit_report.json
audit_report.md
*_anonymize_report.json
*_LEAKS.md
LEAKS.md
main.docx
main.pdf.bak

# 冷启动验证产物（含真实身份，绝不入库）
_cold/

# zhaw flow / weekly / midterm 生成的周期报告（含运行快照，按需重生成）
**/reports/

